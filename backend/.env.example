# Copiá este archivo a .env solo para desarrollo local.
# En AWS, estos mismos valores viven en Secrets Manager (plataforma/odoo, plataforma/culqi, plataforma/db)
# y se inyectan al pod via Secrets Store CSI Driver — nunca se ponen en un .env en producción.

DATABASE_URL="postgresql://plataforma:plataforma@localhost:5432/plataforma_dev"

JWT_SECRET="cambia-esto-en-local"

# Origen público del frontend — se usa para armar el link de los correos de
# activación/recuperación de clave (RF-001). En Testeo/Producción, poner la
# URL real de cada servidor (https://testeo.haskell.com.pe / https://haskell.com.pe).
FRONTEND_URL="http://localhost:3001"

# Odoo 19 Online — API key desde Ajustes > Cuenta > Seguridad > Nueva clave API
ODOO_URL="https://tu-instancia.odoo.com"
ODOO_DB="tu-instancia"
ODOO_USERNAME="usuario-tecnico@tuempresa.com"
ODOO_API_KEY=""
# ID numerico de la compañia (res.company) a la que debe limitarse TODA operacion —
# ver Ajustes > Usuarios y compañias > Compañias > abrir la compañia > ID en la URL.
# Sin este valor la app no arranca (evita que la integracion opere "a ciegas"
# sobre la compañia que tenga por defecto el usuario tecnico en ese momento).
ODOO_COMPANY_ID=""

# Culqi Checkout Custom
CULQI_PUBLIC_KEY=""
CULQI_PRIVATE_KEY=""
CULQI_RSA_ID=""
CULQI_RSA_PUBLIC_KEY=""

# EP-18: cifra en reposo el secreto TOTP de 2FA (roles administrativos) —
# generala vos, ej: openssl rand -hex 32. Sin esto la app no arranca
# (fail-closed, igual que JWT_SECRET) — ver totp-crypto.ts.
TOTP_ENCRYPTION_KEY=""

# Si true, lee secretos desde AWS Secrets Manager en vez de estas variables (usar en EKS)
USE_AWS_SECRETS_MANAGER=false
AWS_REGION="us-east-1"

# Llave compartida con el microservicio whatsapp-bot (ver whatsapp-bot/.env.example,
# BACKEND_SERVICE_KEY debe tener el mismo valor). Generala vos, ej: openssl rand -hex 32
WHATSAPP_BOT_SERVICE_KEY=""
