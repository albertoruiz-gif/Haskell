# Copiá este archivo a .env solo para desarrollo local.
# En AWS, estos mismos valores viven en Secrets Manager (plataforma/odoo, plataforma/culqi, plataforma/db)
# y se inyectan al pod via Secrets Store CSI Driver — nunca se ponen en un .env en producción.

DATABASE_URL="postgresql://plataforma:plataforma@localhost:5432/plataforma_dev"

JWT_SECRET="cambia-esto-en-local"

# Odoo 19 Online — API key desde Ajustes > Cuenta > Seguridad > Nueva clave API
ODOO_URL="https://tu-instancia.odoo.com"
ODOO_DB="tu-instancia"
ODOO_USERNAME="usuario-tecnico@tuempresa.com"
ODOO_API_KEY=""

# Culqi Checkout Custom
CULQI_PUBLIC_KEY=""
CULQI_PRIVATE_KEY=""
CULQI_RSA_ID=""
CULQI_RSA_PUBLIC_KEY=""

# Si true, lee secretos desde AWS Secrets Manager en vez de estas variables (usar en EKS)
USE_AWS_SECRETS_MANAGER=false
AWS_REGION="us-east-1"
