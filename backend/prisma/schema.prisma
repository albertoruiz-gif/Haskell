// Modelo de datos — Plataforma Comercial Multicanal
// Basado en RFD v0.2 seccion 7.1 + adenda v0.3 (porcentaje asesor configurable, ofertas temporales)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Canal {
  SALONES_BELLEZA
  RETAIL
  COMERCIO_MINORISTA
}

enum RolUsuario {
  ADMINISTRADOR
  // Acceso total al tablero de indicadores gerenciales, igual que
  // ADMINISTRADOR/GERENTE_COMERCIAL (pedido de Alberto 2026-08-06) — no
  // tiene todavia un modulo propio de gestion como GerenteComercial/Lider,
  // es puramente un rol de visibilidad hasta que se defina si necesita algo mas.
  GERENTE_GENERAL
  GERENTE_COMERCIAL
  GESTOR_CATALOGO
  LIDER_MINORISTA
  VENDEDOR
  ASESOR
  ALMACEN
  TRANSPORTISTA
  FINANZAS
}

enum TipoTokenAcceso {
  ACTIVACION // primera clave de un usuario recien dado de alta
  RECUPERACION // "olvide mi contraseña"
}

enum EstadoCatalogo {
  BORRADOR
  EN_VALIDACION
  OBSERVADO
  APROBADO
  PROGRAMADO
  PUBLICADO
  SUSPENDIDO
  VENCIDO
}

enum TipoPromocion {
  DESCUENTO_PVP
  COMBO
  REGALO
  OFERTA_TEMPORAL // agregado en adenda v0.3
}

enum AlcanceOferta {
  DIA
  SEMANA
  MES
}

enum AlcancePorcentaje {
  GLOBAL
  CAMPANA
  CANAL
}

enum EstadoEntrega {
  ASIGNADO
  ACEPTADO
  EN_RUTA
  ENTREGADO
  FALLIDO
}

enum EstadoPedido {
  BORRADOR
  PENDIENTE_PAGO
  PAGADO
  STOCK_RESERVADO
  PICKING
  PACKING
  ENTREGADO_TRANSPORTISTA
  EN_RUTA
  ENTREGADO
  ENTREGA_FALLIDA
  CANCELADO_DEVUELTO
  // La reserva de stock (30 min) venció sin que se suba/valide el pago —
  // se libera el stock reservado automáticamente (verificación perezosa,
  // ver InventarioService.liberarReservasVencidas).
  ANULADO_POR_VENCIMIENTO
}

enum EstadoLote {
  NACIONALIZADO
  EN_TRASLADO_ALMACEN
  RECEPCION_PENDIENTE
  CONTROL_CALIDAD
  DISPONIBLE
  BLOQUEADO
  DANADO
  PROXIMO_VENCER
  VENCIDO
  EN_BAJA
  DADO_DE_BAJA
}

enum EstadoReserva {
  RESERVADO_TEMPORAL
  COMPROMETIDO
  CONSUMIDO
  LIBERADO
}

// EP-21 — solo canales SALONES_BELLEZA y RETAIL operan a crédito (decisión
// de negocio 2026-08-13). El "Cliente" es el cliente final del Asesor (un
// salón de belleza o una tienda retail), no el Asesor mismo: es a quien el
// Asesor le abre línea de crédito. En COMERCIO_MINORISTA no existe este
// concepto — el Asesor compra para sí mismo.
enum EstadoCliente {
  ACTIVO
  // Tiene deuda vencida — bloquea pedidos AL_CREDITO nuevos hasta que
  // regularice (RN acordada: "solo contado" mientras esté en mora). No es
  // lo mismo que "sin línea aprobada" (eso es lineaCreditoAprobada null).
  MOROSO
  BLOQUEADO
}

enum EstadoSolicitudCredito {
  PENDIENTE
  APROBADA
  RECHAZADA
}

// EP-04 — descuento por volumen negociado, solo canales SALONES_BELLEZA/
// RETAIL (decisión de negocio 2026-08-15). Minorista no usa esto — sus
// rebajas de precio pasan por el mecanismo de Ofertas ya existente
// (Campaign/Offer), lanzadas también por Gerencia Comercial pero por otro
// camino. Aprobación SIEMPRE por pedido puntual, nunca queda vigente para
// compras futuras — por eso no vive en Cliente como lineaCreditoAprobada.
enum EstadoSolicitudDescuento {
  PENDIENTE
  APROBADA
  RECHAZADA
}

// Cómo se cobra un pedido de canal SALONES_BELLEZA/RETAIL. Para los demás
// canales el pedido siempre es CONTADO_CULQI (sin cambios, RF-017/018).
enum FormaPago {
  CONTADO_CULQI
  CONTADO_DEPOSITO
  AL_CREDITO
}

enum EstadoDeposito {
  PENDIENTE_VALIDACION
  VALIDADO
  RECHAZADO
}

// EP-21 — validación de un RegistroCobro (comprobante adjunto + revisión
// manual) antes de que se aplique de verdad al saldo del cliente. Mismo
// criterio que EstadoSolicitudCredito/EstadoSolicitudDescuento: quien
// registra el cobro (Asesor u otro) nunca lo autoaprueba.
enum EstadoCobro {
  PENDIENTE
  VALIDADO
  RECHAZADO
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  nombre       String
  rol          RolUsuario
  activo       Boolean    @default(true)
  // EP-01 (auditoría 2026-08-12): el JWT es autosuficiente (RolesGuard no
  // vuelve a la base por rol/canal) — así que revocar una sesión no puede
  // ser "borrar el token" (no vive en ningún lado más que en el navegador).
  // En vez de eso, JwtStrategy.validate() compara el "iat" del token contra
  // este campo: cualquier token emitido ANTES de esta fecha deja de sevir,
  // sin importar que todavía no haya expirado. Null = nunca se invalidó
  // nada, todos los tokens vigentes siguen sirviendo.
  sesionesInvalidadasDesde DateTime?

  // EP-18 (2026-08-13): 2FA obligatorio para roles administrativos
  // (ADMINISTRADOR, GERENTE_GENERAL, GERENTE_COMERCIAL, FINANZAS — ver
  // AuthService.ROLES_2FA), con plazo de gracia. totpSecret se guarda
  // cifrado (AES-256-GCM, ver totp-crypto.ts) — a diferencia de
  // passwordHash, este SÍ hay que poder leerlo de vuelta para verificar el
  // código, así que no puede ser un hash de una sola vía.
  totpSecret       String?
  // null = todavía no activó 2FA (puede estar en su plazo de gracia, o ya
  // vencido — eso se decide comparando con totpGraciaHasta, no con esto).
  totpActivadoEn   DateTime?
  // Hasta cuándo puede seguir entrando sin 2FA todavía activo. Se fija al
  // crear el usuario (si su rol ya requiere 2FA) o en el backfill de la
  // migración (para las cuentas que ya existían). Un reset de 2FA por un
  // admin (cuenta comprometida o perdió el segundo factor) NO renueva este
  // plazo a propósito — la idea de resetear es que tenga que reconfigurar
  // ya, no que gane otros 7 días.
  totpGraciaHasta  DateTime?

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  asesor       Asesor?
  transportista Transportista?
  lider        Lider?
  gerenteComercial GerenteComercial?
  auditLogs    AuditLog[] @relation("ActorAuditLog")
  tokensAcceso TokenAcceso[]
  reasignacionesRealizadas HistorialAsignacionAsesor[] @relation("ActorHistorialAsignacion")

  @@map("users")
}

// RF-001: activacion de cuenta nueva y recuperacion de clave olvidada, ambas
// via un link firmado de un solo uso que expira — nunca se guarda el token
// en claro, solo su hash (mismo criterio que passwordHash), para que una
// fuga de la tabla no habilite tomar cuentas.
model TokenAcceso {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id])
  tokenHash String          @unique
  tipo      TipoTokenAcceso
  expiraEn  DateTime
  usadoEn   DateTime?
  createdAt DateTime        @default(now())

  @@index([userId])
  @@map("tokens_acceso")
}

model Asesor {
  id               String       @id @default(cuid())
  userId           String       @unique
  user             User         @relation(fields: [userId], references: [id])
  codigo           String       @unique
  apellidos        String
  tipoDocumento    String
  numeroDocumento  String       @unique
  fechaNacimiento  DateTime
  telefonoPrincipal String
  telefonoSecundario String?
  numeroYape       String
  canal            Canal
  // Solo se completa para asesores de canal COMERCIO_MINORISTA — son los
  // que un Lider afilia y por los que gana comisión (RN líder/comisiones).
  liderId          String?
  lider            Lider?       @relation(fields: [liderId], references: [id])
  odooPartnerId    Int?         // res.partner en Odoo

  direcciones      Direccion[]
  carts            Cart[]
  pedidos          Order[]
  clientes         Cliente[] // EP-21 — sus clientes finales en canales SALONES_BELLEZA/RETAIL
  historialAsignaciones HistorialAsignacionAsesor[] // EP-02 — cada cambio de líder de este asesor

  createdAt        DateTime     @default(now())

  @@map("asesores")
}

// EP-02: cada vez que un asesor de Comercio Minorista cambia de líder
// (AfiliacionService.reasignarLider) queda un registro acá, además de
// actualizar Asesor.liderId. liderAnteriorId/liderNuevoId son snapshots
// (String simple, sin FK) a propósito, igual que AuditLog.entidadId — si
// un líder se da de baja después, el historial sigue mostrando quién era
// en ese momento en vez de romperse o quedar en null.
model HistorialAsignacionAsesor {
  id              String   @id @default(cuid())
  asesorId        String
  asesor          Asesor   @relation(fields: [asesorId], references: [id])
  liderAnteriorId String?
  liderNuevoId    String?
  actorId         String
  actor           User     @relation("ActorHistorialAsignacion", fields: [actorId], references: [id])
  motivo          String?
  createdAt       DateTime @default(now())

  @@index([asesorId])
  @@map("historial_asignaciones_asesor")
}

model Direccion {
  id             String   @id @default(cuid())
  asesorId       String
  asesor         Asesor   @relation(fields: [asesorId], references: [id])
  departamento   String
  provincia      String
  distrito       String
  direccion      String
  referencia     String?
  pais           String   @default("Perú")
  predeterminada Boolean  @default(false)

  @@map("direcciones")
}

// Transportista autorizado — módulo Transporte/Delivery. Pago fijo por
// entrega (elegido sobre pago por zona o registro manual sin fórmula).
model Transportista {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id])
  telefono          String
  placa             String?
  tarifaPorEntrega  Decimal  @db.Decimal(10, 2)
  // res.partner en Odoo, tipo proveedor de servicio (se le factura al pagarle) —
  // ver catalogo-haskell/PROMPT_sync_delivery_a_odoo.md
  odooPartnerId     Int?

  entregas          Entrega[]

  createdAt         DateTime @default(now())

  @@map("transportistas")
}

// Líder/Supervisor de equipo — afilia y tiene a cargo asesores de canal
// COMERCIO_MINORISTA, y gana una comisión sobre sus ventas (rol
// LIDER_MINORISTA). comisionPct es propio de cada líder, no global.
model Lider {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  telefono     String
  comisionPct  Decimal  @default(5) @db.Decimal(5, 2)

  asesores     Asesor[]

  createdAt    DateTime @default(now())

  @@map("lideres")
}

// Gerente Comercial — a cargo de los asesores de Salones de Belleza y
// Retail (fija su % de comisión vía PricingConfig), y además gana una
// comisión propia sobre el total de ventas de los 3 canales.
model GerenteComercial {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  telefono     String
  comisionPct  Decimal  @default(4) @db.Decimal(5, 2)

  createdAt    DateTime @default(now())

  @@map("gerentes_comerciales")
}

model Tarifa {
  id             String   @id @default(cuid())
  distrito       String   @unique
  zona           String?
  precio         Decimal  @db.Decimal(10, 2)
  slaHoras       Int      @default(36)
  activa         Boolean  @default(true)
  vigenciaDesde  DateTime @default(now())
  vigenciaHasta  DateTime?

  @@map("tarifas")
}

model Campaign {
  id            String     @id @default(cuid())
  codigo        String     @unique
  nombre        String
  descripcion   String?
  fechaInicio   DateTime
  fechaFin      DateTime
  estado        String     @default("BORRADOR")
  canalesObjetivo Canal[]

  catalogos     Catalog[]
  pricingConfigs PricingConfig[]

  createdAt     DateTime   @default(now())

  @@map("campaigns")
}

model Catalog {
  id                     String         @id @default(cuid())
  campaignId             String
  campaign               Campaign       @relation(fields: [campaignId], references: [id])
  canal                  Canal
  version                Int            @default(1)
  estado                 EstadoCatalogo @default(BORRADOR)
  vigenciaDesde           DateTime?
  vigenciaHasta           DateTime?
  responsableCargaId      String?
  responsableAprobacionId String?
  motivoObservacion       String?

  lineas                 CatalogLine[]
  ofertas                Offer[]
  pricingConfigs          PricingConfig[]

  createdAt               DateTime      @default(now())
  updatedAt                DateTime     @updatedAt

  @@unique([campaignId, canal, version])
  @@map("catalogs")
}

model CatalogLine {
  id                       String   @id @default(cuid())
  catalogId                String
  catalog                  Catalog  @relation(fields: [catalogId], references: [id])
  sku                      String   // validado contra Odoo product.product
  nombre                   String?
  categoria                String?
  linea                    String?
  subcategoria             String?
  tipo                     String?
  descripcion              String?  @db.Text
  beneficios               String?  @db.Text
  propiedades              String?  @db.Text
  modoUso                  String?  @db.Text
  activos                  String?  @db.Text
  pvpCampania              Decimal  @db.Decimal(10, 2)
  imagenUrl                String?
  imagenesAdicionales      String[] @default([])
  ordenVisualizacion        Int      @default(0)
  destacado                 Boolean  @default(false)
  cantidadMaximaPorAsesor   Int?
  // Derivado de los lotes (físico en estado DISPONIBLE/PROXIMO_VENCER menos
  // reservas activas) — ya NO es editable a mano, se recalcula cada vez que
  // cambia un lote o una reserva (ver InventarioService.recalcularStock).
  stockDisponible           Int      @default(0)
  // Marca si este SKU tiene stock físico real confirmado (conteo/PDF de
  // inventario cruzado contra Odoo) — a diferencia de stockDisponible (el
  // pool de lotes de ESTA línea, hoy desconectado entre canales), esto es
  // el gate de visibilidad: sin stock confirmado, el producto no aparece
  // en el catálogo salvo que lo busquen por nombre o SKU exacto (ver
  // catalog.controller.ts catalogoVigente) — así se puede consultar ficha
  // técnica sin poder comprarlo.
  stockConfirmado           Boolean  @default(false)

  ofertas                  Offer[]
  cartItems                 CartItem[]
  lotes                    LoteInventario[]
  // Si tiene filas acá, este producto ES un pack — su pvpCampania se
  // calcula sumando cada componente ya con el descuento propio del pack
  // (independiente de la oferta normal que el componente pueda tener por
  // separado). Se arma/edita desde Gestión → Ofertas y Packs.
  packComponentes          PackComponente[] @relation("PackComponentes")
  // Packs de los que este producto es componente (para mostrar "incluido en" en su ficha)
  parteDePacks             PackComponente[] @relation("ComponenteDePacks")

  @@unique([catalogId, sku])
  @@map("catalog_lines")
}

model PackComponente {
  id            String      @id @default(cuid())
  packId        String
  pack          CatalogLine @relation("PackComponentes", fields: [packId], references: [id])
  componenteId  String
  componente    CatalogLine @relation("ComponenteDePacks", fields: [componenteId], references: [id])
  descuentoPct  Decimal     @default(0) @db.Decimal(5, 2) // % de descuento sobre el precio del componente, propio de este pack
  createdAt     DateTime    @default(now())

  @@unique([packId, componenteId])
  @@map("pack_componentes")
}

// Lote de inventario — se controla desde su nacionalización/ingreso al
// almacén (Haskell Perú no modela la etapa de compra/embarque/aduanas
// previa, eso queda fuera de este sistema) hasta su venta, devolución o
// baja. FEFO real: al reservar se toma primero el lote con fechaVencimiento
// más próxima entre los que están DISPONIBLE/PROXIMO_VENCER.
model LoteInventario {
  id                       String     @id @default(cuid())
  catalogLineId            String
  catalogLine              CatalogLine @relation(fields: [catalogLineId], references: [id])
  numeroLote               String
  proveedor                String?
  paisOrigen               String?
  ordenCompra               String?
  documentoImportacion      String?
  fechaFabricacion          DateTime?
  fechaVencimiento          DateTime?
  cantidadImportada         Int?
  cantidadRecibida          Int        @default(0)
  cantidadDanada            Int        @default(0)
  costoFob                  Decimal?   @db.Decimal(10, 2)
  costoFleteSeguro          Decimal?   @db.Decimal(10, 2)
  gastosAduaneros           Decimal?   @db.Decimal(10, 2)
  costoTotalNacionalizado   Decimal?   @db.Decimal(10, 2)
  costoUnitarioReal         Decimal?   @db.Decimal(10, 2)
  ubicacionAlmacen          String?
  estado                    EstadoLote @default(NACIONALIZADO)
  responsableRecepcionId    String?
  fechaLiberacion           DateTime?
  motivoBloqueo             String?

  reservas                  ReservaStock[]

  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@map("lotes_inventario")
}

// Reserva de stock contra un lote específico (FEFO) por cada línea de
// pedido — RESERVADO_TEMPORAL nace con expiraEn (30 min) al crear el
// pedido; pasa a COMPROMETIDO al pagar; a CONSUMIDO al entregar; o a
// LIBERADO si se cancela, falla la entrega, o vence sin pagarse.
model ReservaStock {
  id            String        @id @default(cuid())
  loteId        String
  lote          LoteInventario @relation(fields: [loteId], references: [id])
  orderItemId   String
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id])
  cantidad      Int
  estado        EstadoReserva @default(RESERVADO_TEMPORAL)
  expiraEn      DateTime?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("reservas_stock")
}

// Ofertas temporales (dia/semana/mes) — adenda v0.3, extiende RF-043/RF-044
model Offer {
  id             String         @id @default(cuid())
  catalogId      String
  catalog        Catalog        @relation(fields: [catalogId], references: [id])
  catalogLineId  String?
  catalogLine    CatalogLine?   @relation(fields: [catalogLineId], references: [id])
  tipo           TipoPromocion  @default(OFERTA_TEMPORAL)
  alcance        AlcanceOferta
  descuentoPct   Decimal?       @db.Decimal(5, 2) // ej. 25.00 = 25%
  precioFijo     Decimal?       @db.Decimal(10, 2)
  inicio         DateTime
  fin            DateTime
  creadoPorId    String
  aprobadoPorId  String?
  activa         Boolean        @default(true)
  // Reflejo en Odoo (product.pricelist.item, lista "Ofertas vigentes") para
  // que facturación/Hasky/reportes lean el precio real sin depender de esta
  // plataforma — ver catalogo-haskell/PROMPT_trasladar_ofertas_a_odoo.md.
  // Null si la oferta no tiene catalogLineId o si la sincronización falló.
  odooPricelistItemId Int?

  createdAt      DateTime       @default(now())

  @@map("offers")
}

// Porcentaje del asesor configurable — adenda v0.3, modifica RN-008
model PricingConfig {
  id               String            @id @default(cuid())
  alcance          AlcancePorcentaje @default(GLOBAL)
  campaignId       String?
  campaign         Campaign?         @relation(fields: [campaignId], references: [id])
  catalogId        String?
  catalog          Catalog?          @relation(fields: [catalogId], references: [id])
  canal            Canal?
  porcentajeAsesor Decimal           @default(80.00) @db.Decimal(5, 2)
  actualizadoPorId String
  createdAt        DateTime          @default(now())

  @@map("pricing_configs")
}

// Meta/objetivo por indicador del tablero gerencial (comercial/financiero/
// operativo) — vive en esta plataforma y no en Odoo porque Odoo no tiene un
// campo generico de objetivo que cubra ventas, margen, inventario y caja a
// la vez; lo mas cercano (meta de facturacion del equipo en crm.team) solo
// cubriria ventas. canal null = meta global del indicador; con canal = meta
// especifica para ese canal (ej. margen bruto por canal). vigenciaHasta null
// = sigue vigente hasta que se cargue una meta nueva para el mismo par
// indicador/canal.
model MetaIndicador {
  id               String    @id @default(cuid())
  indicador        String    // clave del indicador, ej. "ventas_netas", "margen_bruto_canal"
  canal            Canal?
  valorObjetivo    Decimal   @db.Decimal(12, 2)
  vigenciaDesde    DateTime  @default(now())
  vigenciaHasta    DateTime?
  actualizadoPorId String

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([indicador, canal])
  @@map("metas_indicadores")
}

// Escala de premios por venta mensual, por canal — RF pedido por Alberto
// 2026-08-07 ("cuánto falta para el premio" en Carrito, configurado por el
// Gerente Comercial en Gestión → Premios). Mismo patrón de versionado que
// MetaIndicador (vigenciaDesde/vigenciaHasta): editar un nivel no lo
// sobrescribe, cierra el vigente y crea uno nuevo, así los meses pasados
// siguen mostrando la escala que realmente estaba activa entonces. El nivel
// alcanzado en un mes es el de mayor montoMinimo <= venta PVP del asesor
// ese mes (suma de OrderItem.pvpUnitario × cantidad, igual que
// LideresService/IndicadoresService) — no hay paso de "entregado", es solo
// informativo (decisión explícita del usuario).
model PremioNivel {
  id               String    @id @default(cuid())
  canal            Canal
  nombre           String
  descripcion      String?
  montoMinimo      Decimal   @db.Decimal(12, 2)
  vigenciaDesde    DateTime  @default(now())
  vigenciaHasta    DateTime?
  actualizadoPorId String

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([canal, vigenciaDesde])
  @@map("premios_niveles")
}

// Gasto de marketing/publicidad por período — carga manual porque no hay
// integración con plataformas de ads todavía. Es el numerador de CAC
// (indicador "cac" en indicadores.constants.ts); mientras no exista esta
// carga para un período, CAC queda en null. canal null = gasto general no
// atribuible a un canal puntual (ej. campaña de marca).
model GastoMarketing {
  id               String    @id @default(cuid())
  descripcion      String    // ej. "Meta Ads agosto 2026", "Google Ads lanzamiento"
  canal            Canal?
  monto            Decimal   @db.Decimal(12, 2)
  periodoDesde     DateTime
  periodoHasta     DateTime
  registradoPorId  String

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([periodoDesde, periodoHasta])
  @@map("gastos_marketing")
}

// Insumos financieros de carga manual, un registro por mes (RF 2026-08-07:
// fórmulas de Indicadores_Financieros_Dashboard_Haskell.md). No hay fuente
// automática hoy (Odoo Contabilidad sin conectar) — mismo patrón que
// GastoMarketing. IndicadoresService.finanzas() aplica las fórmulas sobre
// el registro del mes vigente + ventas_netas ya calculado localmente.
model DatoFinancieroMensual {
  id                       String   @id @default(cuid())
  periodo                  DateTime // día 1 del mes, único
  costoVentas              Decimal  @db.Decimal(12, 2)
  cobros                   Decimal  @db.Decimal(12, 2)
  pagosProveedores         Decimal  @db.Decimal(12, 2)
  gastosOperativos         Decimal  @db.Decimal(12, 2)
  sueldos                  Decimal  @db.Decimal(12, 2)
  impuestos                Decimal  @db.Decimal(12, 2)
  inventarioPromedio       Decimal  @db.Decimal(12, 2)
  cuentasPorCobrarPromedio Decimal  @db.Decimal(12, 2)
  cuentasPorPagarPromedio  Decimal  @db.Decimal(12, 2)
  compras                  Decimal  @db.Decimal(12, 2)
  cuentasPorCobrarVencidas Decimal  @db.Decimal(12, 2)
  costoImportadoUnitario   Decimal? @db.Decimal(12, 2)
  registradoPorId          String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([periodo])
  @@map("datos_financieros_mensuales")
}

// EP-21 — Cliente final del Asesor (canales SALONES_BELLEZA/RETAIL). No
// confundir con Asesor: el Asesor es quien vende en nombre de Haskell, el
// Cliente es a quien le vende y a quien eventualmente se le abre crédito.
// numeroDocumento único por canal (no globalmente): el mismo RUC podría
// aparecer en Salón y Retail si de verdad son negocios distintos del mismo
// dueño — se decide por asesor/canal, no se fuerza unicidad global.
model Cliente {
  id                    String        @id @default(cuid())
  asesorId              String
  asesor                Asesor        @relation(fields: [asesorId], references: [id])
  canal                 Canal
  razonSocialONombre    String
  tipoDocumento         String
  numeroDocumento       String
  telefono              String
  email                 String?
  direccion             String?
  estado                EstadoCliente @default(ACTIVO)
  // null = sin línea de crédito aprobada todavía (debe pagar CONTADO). Se
  // completa recién cuando una SolicitudCredito de este cliente pasa a
  // APROBADA (ver SolicitudCreditoService.aprobar).
  lineaCreditoAprobada  Decimal?      @db.Decimal(10, 2)
  // Suma de totalCulqi de pedidos AL_CREDITO todavía no cobrados (RegistroCobro).
  // Se mantiene con incrementos/decrementos atómicos, no se recalcula desde
  // cero en cada lectura (ver ClientesService).
  saldoUtilizado        Decimal       @default(0) @db.Decimal(10, 2)
  odooPartnerId         Int?          // res.partner en Odoo, con credit_limit nativo

  solicitudesCredito    SolicitudCredito[]
  solicitudesDescuento  SolicitudDescuento[]
  pedidos               Order[]
  cobros                RegistroCobro[]

  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@unique([canal, numeroDocumento])
  @@index([asesorId])
  @@map("clientes")
}

// Flujo de aprobación de línea de crédito — SIEMPRE resuelto por
// GERENTE_COMERCIAL (decisión de negocio 2026-08-13, sin excepción por
// canal ni por monto). El Asesor solicita, nunca se autoaprueba.
model SolicitudCredito {
  id              String                  @id @default(cuid())
  clienteId       String
  cliente         Cliente                 @relation(fields: [clienteId], references: [id])
  solicitadoPorId String                  // User.id del Asesor
  lineaSolicitada Decimal                 @db.Decimal(10, 2)
  motivo          String?                 @db.Text
  estado          EstadoSolicitudCredito  @default(PENDIENTE)
  revisadoPorId   String?                 // User.id del GerenteComercial que resolvió
  lineaAprobada   Decimal?                @db.Decimal(10, 2)
  motivoRechazo   String?                 @db.Text
  resueltoEn      DateTime?

  createdAt       DateTime                @default(now())

  @@index([clienteId])
  @@index([estado])
  @@map("solicitudes_credito")
}

// EP-04 — descuento por volumen negociado, aprobación por pedido puntual
// (nunca queda vigente para compras futuras). Umbral de quién aprueba
// (decisión de negocio 2026-08-15): hasta 5% GERENTE_COMERCIAL, más de 5%
// GERENTE_GENERAL — validado en ClientesService, no solo con @Roles, porque
// depende del VALOR solicitado, no únicamente del rol del actor.
model SolicitudDescuento {
  id              String                   @id @default(cuid())
  clienteId       String
  cliente         Cliente                  @relation(fields: [clienteId], references: [id])
  solicitadoPorId String                   // User.id del Asesor
  porcentaje      Decimal                  @db.Decimal(5, 2) // ej. 5.00 = 5%
  motivo          String?                  @db.Text
  estado          EstadoSolicitudDescuento @default(PENDIENTE)
  revisadoPorId   String?                  // User.id de quien resolvió (GerenteComercial o GerenteGeneral)
  motivoRechazo   String?                  @db.Text
  resueltoEn      DateTime?
  // Se completa cuando el Asesor efectivamente arma el pedido con este
  // descuento (ver Order.solicitudDescuentoId) — a partir de ahí queda
  // "consumida", no se puede reusar en otro pedido.
  pedido          Order?

  createdAt       DateTime                 @default(now())

  @@index([clienteId])
  @@index([estado])
  @@map("solicitudes_descuento")
}

// Cobranza ligera (decisión de negocio: sin módulo de cobranzas completo).
// Un registro por cada pago que el Cliente hace contra su deuda AL_CREDITO
// acumulada — no está atado a un pedido puntual porque un cliente puede
// pagar varios pedidos de una vez o parcialmente.
//
// EP-21 (2026-08-17): quien registra el cobro (típicamente el Asesor) ya
// no lo aplica de una — nace en PENDIENTE con el comprobante adjunto, y
// recién se descuenta de Cliente.saldoUtilizado cuando alguien de Gerencia
// Comercial/Administración/Finanzas lo valida (ver ClientesService.validarCobro),
// igual que ya pasa con SolicitudCredito/SolicitudDescuento.
model RegistroCobro {
  id              String      @id @default(cuid())
  clienteId       String
  cliente         Cliente     @relation(fields: [clienteId], references: [id])
  monto           Decimal     @db.Decimal(10, 2)
  metodo          String      // "deposito" | "culqi" | "efectivo"
  numeroOperacion String?
  banco           String?
  comprobanteUrl  String?
  estado          EstadoCobro @default(PENDIENTE)
  revisadoPorId   String?     // User.id de quien validó/rechazó
  motivoRechazo   String?     @db.Text
  resueltoEn      DateTime?
  registradoPorId String      // User.id — Asesor o GerenteComercial
  observaciones   String?     @db.Text

  createdAt       DateTime @default(now())

  @@index([clienteId])
  @@index([estado])
  @@map("registros_cobro")
}

model Cart {
  id            String     @id @default(cuid())
  asesorId      String
  asesor        Asesor     @relation(fields: [asesorId], references: [id])
  direccionId   String?
  items         CartItem[]
  vigenciaHasta DateTime   // reserva temporal, RN-016 (15 min por defecto)

  createdAt     DateTime   @default(now())

  @@map("carts")
}

model CartItem {
  id            String       @id @default(cuid())
  cartId        String
  cart          Cart         @relation(fields: [cartId], references: [id])
  catalogLineId String
  catalogLine   CatalogLine  @relation(fields: [catalogLineId], references: [id])
  cantidad      Int

  @@map("cart_items")
}

// Pedido — snapshot histórico obligatorio (RN-007, RN-038, adenda seccion 1)
model Order {
  id                    String       @id @default(cuid())
  asesorId              String
  asesor                Asesor       @relation(fields: [asesorId], references: [id])
  canal                 Canal
  campaignId            String
  catalogId             String
  catalogVersion         Int
  direccionSnapshot      Json         // copia histórica de la dirección
  tarifaSnapshot          Decimal      @db.Decimal(10, 2)
  slaHorasSnapshot         Int?        // copia de Tarifa.slaHoras vigente al crear el pedido (RF-030)
  pagadoEn                 DateTime?   // cuando se valida el pago — arranca el conteo del SLA de entrega
  subtotalAsesor          Decimal      @db.Decimal(10, 2)
  // totalCulqi = lo que realmente se cobra (Yape/depósito/crédito), con
  // IGV incluido, YA descontado si corresponde — es el "precio final" al
  // que se le calcula el desglose de abajo, nunca al revés (EP-04, decisión
  // de negocio 2026-08-15: "Haskell tiene en sus precios el IGV incluido").
  totalCulqi              Decimal      @db.Decimal(10, 2)
  estado                  EstadoPedido @default(BORRADOR)

  // EP-04 — descuento por volumen (solo canales SALONES_BELLEZA/RETAIL,
  // aprobado por pedido puntual — ver SolicitudDescuento). 0 por defecto.
  solicitudDescuentoId     String?      @unique
  solicitudDescuento       SolicitudDescuento? @relation(fields: [solicitudDescuentoId], references: [id])
  descuentoPct             Decimal      @default(0) @db.Decimal(5, 2)
  descuentoMonto           Decimal      @default(0) @db.Decimal(10, 2)
  // IGV (18%) calculado hacia atrás desde totalCulqi (ya con descuento
  // aplicado): igv = totalCulqi - (totalCulqi / 1.18); valorVenta = resto.
  // Se calcula para TODOS los pedidos (no solo Salón/Retail) — el IGV
  // incluido en el precio aplica a toda venta, el descuento es lo único
  // restringido por canal.
  igv                      Decimal      @db.Decimal(10, 2)
  valorVenta               Decimal      @db.Decimal(10, 2)

  // EP-21 — solo se completa en canales SALONES_BELLEZA/RETAIL. Null en
  // COMERCIO_MINORISTA (el Asesor compra para sí, no hay Cliente final).
  clienteId               String?
  cliente                 Cliente?     @relation(fields: [clienteId], references: [id])
  formaPago                FormaPago    @default(CONTADO_CULQI)
  // Solo con formaPago = CONTADO_DEPOSITO. La validación (RN acordada: el
  // monto depositado debe coincidir con totalCulqi, dentro de la tolerancia
  // configurable en ConfiguracionSistema — EP-16, 2026-08-18) la resuelve
  // GERENTE_COMERCIAL o FINANZAS a mano — no hay conciliación bancaria
  // automática con el banco todavía, esto solo evita validar a ciegas un
  // monto que no coincide.
  depositoEstado           EstadoDeposito?
  depositoNumeroOperacion  String?
  depositoBanco            String?
  depositoComprobanteUrl   String?
  // Nullable a propósito: depósitos registrados antes de este cambio no
  // tienen este dato — validarDeposito() se salta el chequeo de tolerancia
  // cuando es null, no lo trata como una diferencia de S/0.
  depositoMonto            Decimal?     @db.Decimal(10, 2)
  depositoValidadoPorId    String?
  depositoValidadoEn       DateTime?
  referenciaWeb            String       @unique @default(cuid()) // idempotencia RF-020, no pensado para mostrarse
  // Numero de pedido legible para la asesora (confirmacion web/email) y para
  // matchear el pedido en Odoo (stock.picking.x_pedido_externo_id) — a
  // diferencia de referenciaWeb, este SI se muestra y se puede dictar/escribir
  // a mano. Formato de exhibicion (ver common/numero-pedido.util.ts):
  // HSK_<CANAL>_<este numero con ceros a la izquierda>, ej. HSK_MIN_000123.
  numero                   Int          @unique @default(autoincrement())
  odooSaleOrderId          Int?
  odooSaleOrderName        String?

  items                   OrderItem[]
  pagos                    Payment[]
  entrega                  Entrega?

  createdAt                 DateTime    @default(now())
  updatedAt                  DateTime   @updatedAt

  @@map("orders")
}

// Entrega — maestro Web segun tabla 7.1 del RFD (RN-021 a RN-024, RF-027 a RF-030)
model Entrega {
  id                 String        @id @default(cuid())
  orderId            String        @unique
  order              Order         @relation(fields: [orderId], references: [id])
  transportistaId    String
  transportista      Transportista @relation(fields: [transportistaId], references: [id])
  estado             EstadoEntrega @default(ASIGNADO)
  bultos             Int           @default(1)
  aceptadoEn         DateTime?
  receptor           String?
  documentoReceptor  String?
  evidenciaUrl        String?      // foto/firma/OTP segun DP-010 (pendiente de decision exacta)
  motivoFallo         String?
  observaciones        String?
  montoPago            Decimal?    @db.Decimal(10, 2) // snapshot de Transportista.tarifaPorEntrega al entregar
  pagado               Boolean     @default(false)
  pagadoEn             DateTime?

  // EP-12 (2026-08-17): reprogramar una entrega FALLIDO vuelve a ASIGNADO
  // (mismo transportista, re-comprometiendo stock — ver
  // OperacionesService.reprogramarEntrega) en vez de crear una fila nueva
  // (Entrega.orderId es único). fechaReprogramada es la nueva fecha
  // prometida para el reintento; motivoReprogramacion es aparte de
  // motivoFallo (por qué falló vs. qué se acordó para el reintento).
  fechaReprogramada    DateTime?
  motivoReprogramacion String?
  vecesReprogramada    Int         @default(0)

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@map("entregas")
}

model OrderItem {
  id                       String   @id @default(cuid())
  orderId                  String
  order                    Order    @relation(fields: [orderId], references: [id])
  sku                      String
  nombre                   String
  pvpUnitario               Decimal  @db.Decimal(10, 2)
  porcentajeAsesorAplicado  Decimal  @db.Decimal(5, 2) // snapshot del % vigente al pagar
  precioAsesorUnitario      Decimal  @db.Decimal(10, 2)
  cantidad                  Int
  promocionAplicada          Json?
  reservas                  ReservaStock[]

  @@map("order_items")
}

model Payment {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id])
  culqiToken     String? // uso único, no se conserva mas de lo necesario (RF-018)
  culqiChargeId  String?  @unique
  estado         String   @default("INICIADO") // iniciado|pendiente|aprobado|rechazado|anulado|reembolsado
  montoCentimos  Int
  respuestaJson  Json?

  createdAt      DateTime @default(now())

  @@map("payments")
}

model AuditLog {
  id              String   @id @default(cuid())
  actorId         String
  actor           User     @relation("ActorAuditLog", fields: [actorId], references: [id])
  accion          String
  entidad         String
  entidadId       String
  valoresAntes    Json?
  valoresDespues  Json?
  motivo          String?
  createdAt       DateTime @default(now())

  @@map("audit_logs")
}

// EP-01: overrides de roles por endpoint, editables desde Gestión →
// Permisos sin pasar por un deploy. clave = "<Controller>.<metodo>" (mismo
// par que arma RolesGuard en tiempo de ejecución vía
// context.getClass().name/context.getHandler().name — ver
// PermisosService.rolesEfectivos y el catálogo estático en
// permisos-catalogo.ts). Tabla vacía = comportamiento idéntico al @Roles()
// compilado en cada controller; solo lo que un ADMINISTRADOR edita a
// propósito aparece acá.
model PermisoOverride {
  clave            String       @id
  roles            RolUsuario[]
  actualizadoPorId String?
  updatedAt        DateTime     @updatedAt

  @@map("permisos_override")
}

// Catálogo digital editorial (tipo flipbook Yanbal) — se arma por fuera de
// la plataforma y se sube como .zip (index.html + imágenes) para publicarlo
// con una URL propia. No tiene relación con Catalog/CatalogLine: ese es el
// catálogo operativo con precios por canal que usan los asesores para
// vender; este es solo un sitio estático para compartir con clientes.
model CatalogoDigital {
  id          String   @id @default(cuid())
  nombre      String
  raiz        String   @default("") // subcarpeta dentro del zip donde vive index.html, si no está en la raíz
  activo      Boolean  @default(true)
  subidoPorId String?
  createdAt   DateTime @default(now())

  @@map("catalogos_digitales")
}

// Libro de Reclamaciones (requisito legal Perú — DS 011-2011-PCM y
// normativa asociada, independiente de Culqi: toda web que ofrezca
// productos/servicios debe tenerlo). Autoconstruido, sin SaaS externo, ver
// docs/PROMPT_culqi_requisitos_web.md.
enum TipoReclamo {
  RECLAMO // disconformidad con el producto/servicio
  QUEJA // disconformidad con la atención — categoría legal distinta, no cosmética
}

enum EstadoReclamo {
  RECIBIDO
  EN_PROCESO
  RESPONDIDO
}

model Reclamo {
  id                        String        @id @default(cuid())
  codigo                    String        @unique // constancia mostrada al consumidor al enviar
  tipo                      TipoReclamo
  consumidorNombre          String
  consumidorTipoDocumento   String
  consumidorNumeroDocumento String
  consumidorDomicilio       String
  consumidorTelefono        String
  consumidorEmail           String
  bienOServicioReclamado    String
  montoReclamado            Decimal?      @db.Decimal(10, 2)
  detalle                   String        @db.Text
  pedidoConsumidor          String        @db.Text
  estado                    EstadoReclamo @default(RECIBIDO)
  respuesta                 String?       @db.Text
  respondidoPorId           String?
  createdAt                 DateTime      @default(now())
  respondidoEn              DateTime?

  @@map("reclamos")
}

// Configuración editable desde Gestión → Configuración, sin pasar por una
// migración. Fila única (singleton, id fijo "global") — se crea sola con
// los defaults la primera vez que se lee (ver ConfiguracionService). Pensada
// para crecer con otros parámetros de EP-16 (tolerancia de conciliación de
// vouchers, plantillas de correo, feature flags) sin agregar una tabla por
// cada uno.
model ConfiguracionSistema {
  id                  String   @id @default("global")
  // EP-06/EP-09: minutos que se reserva el stock de un pedido recién creado
  // (PENDIENTE_PAGO) antes de liberarse solo — ver InventarioService.
  minutosReservaStock Int      @default(30)
  // EP-16 (2026-08-18): margen aceptado entre lo que el asesor declara que
  // depositó (Order.depositoMonto) y el total real del pedido antes de que
  // validarDeposito() rechace por diferencia — ver OrdersService.
  toleranciaConciliacionSoles Decimal @default(5) @db.Decimal(10, 2)
  // EP-16: interruptores genéricos clave->boolean, editables desde Gestión
  // → Configuración sin deploy — a propósito NO son columnas tipadas una
  // por una (crecen sin migración nueva cada vez que se agrega un flag).
  featureFlags        Json     @default("{}")
  actualizadoPorId    String?
  updatedAt           DateTime @updatedAt

  @@map("configuracion_sistema")
}
