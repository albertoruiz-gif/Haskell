# Copiá esto a .env solo para desarrollo local. En Railway (o el hosting que
# elijas) estas mismas variables se cargan como variables de entorno del
# servicio, no como archivo .env commiteado.

PORT=3100

# --- Meta WhatsApp Cloud API (modo sandbox/prueba) ---
# Meta for Developers > tu app > WhatsApp > Configuracion de la API
# "Token de acceso temporal" (dura ~24h, luego hay que generar uno nuevo
# hasta que se tramite el token permanente con Business verificado).
WHATSAPP_ACCESS_TOKEN=""

# Meta for Developers > tu app > WhatsApp > Configuracion de la API > "Id de numero de telefono"
WHATSAPP_PHONE_NUMBER_ID=""

# Inventalo vos mismo (cualquier string). Se lo pegas a Meta al configurar el
# webhook ("Verify token") y tiene que coincidir exactamente con este valor.
WHATSAPP_VERIFY_TOKEN="cambia-esto-por-un-token-propio"

# Version de la Graph API (revisa la mas reciente en developers.facebook.com/docs/graph-api/changelog)
WHATSAPP_GRAPH_API_VERSION="v21.0"

# --- Backend de la plataforma (para consultar estado de pedido) ---
BACKEND_API_URL="http://localhost:3000/api"
# Debe ser identico a WHATSAPP_BOT_SERVICE_KEY en backend/.env
BACKEND_SERVICE_KEY=""
