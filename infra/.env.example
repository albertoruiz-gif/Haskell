# Copiá este archivo a infra/.env. Sin este archivo, docker-compose usa los
# valores por defecto (plataforma/plataforma) — suficiente para desarrollo
# local, pero NUNCA para Test o Producción: ahí completá valores reales.

# Credenciales de Postgres (el mismo valor se usa para armar DATABASE_URL
# del backend automáticamente, no hace falta repetirlo en backend/.env).
POSTGRES_USER=plataforma
POSTGRES_PASSWORD=cambia-esto-por-un-valor-fuerte
POSTGRES_DB=plataforma_dev

# URL pública por la que el navegador del usuario llega a la API — en
# Test/Producción, el dominio propio con HTTPS (ej. https://haskell.com.pe/api).
# Se hornea en el build del frontend, así que si cambia hay que reconstruir
# la imagen (docker compose up --build).
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Dominio propio de ESTE servidor (sin protocolo). Producción: haskell.com.pe
# Testeo: testeo.haskell.com.pe. Nginx lo usa para el bloque HTTPS y para
# encontrar el certificado en /etc/letsencrypt/live/<DOMAIN>/ (ver Certbot en
# docs/DESPLIEGUE_AWS.md).
DOMAIN=localhost

# Widget de Live Chat de Odoo (Hasky) en la esquina inferior derecha de la web.
# Se hornea en el build del frontend (docker compose up --build para que tome
# el cambio). SOLO poner "true" en Producción: el widget conecta contra el
# Odoo real (Haskell_Distribuidor) y cada conversación de prueba crearía un
# lead/oportunidad real en el CRM. En Desarrollo y Testeo dejar en false.
NEXT_PUBLIC_ODOO_LIVECHAT_ACTIVO=false
